# study-and-harden config (read by scripts/study.py). Edit per machine.
# The study folder must live inside an Obsidian vault that has the Dataview plugin enabled.
OBSIDIAN_VAULT_NAME="_Learning_Resource"
OBSIDIAN_VAULT_PATH="$HOME/Documents/Personal_resources/_Obsidian/_Learning_Resource"
STUDY_ROOT="${OBSIDIAN_VAULT_PATH}/Study"
